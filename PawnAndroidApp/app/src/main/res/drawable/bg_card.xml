<?xml version="1.0" encoding="utf-8"?>
<!--
  A card with thickness: the ledge it sits on, an edge brighter at the top as a
  bevel is, and a surface that catches more light at its head than at its foot.
  Figures sit on the plain lower part of it, so nothing here competes with them.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_ledge" />
            <corners android:radius="@dimen/r_lg" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/card_edge_hi" android:endColor="@color/parchment_line" />
            <corners android:radius="@dimen/r_lg" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="@color/card_top" android:endColor="@color/surface" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</layer-list>
