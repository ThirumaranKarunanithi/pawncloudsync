<?xml version="1.0" encoding="utf-8"?>
<!-- A bill row. The metal is the left edge, not a word. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/silver" />
            <corners android:radius="@dimen/r_md" />
        </shape>
    </item>
    <item android:left="@dimen/metal_edge_w">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/parchment_line" />
            <corners android:topLeftRadius="0dp" android:bottomLeftRadius="0dp"
                android:topRightRadius="@dimen/r_md" android:bottomRightRadius="@dimen/r_md" />
        </shape>
    </item>
</layer-list>
