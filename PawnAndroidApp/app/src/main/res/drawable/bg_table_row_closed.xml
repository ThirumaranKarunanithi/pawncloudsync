<?xml version="1.0" encoding="utf-8"?>
<!-- A bill-by-bill MIS row, closed: the desktop's colour for that event. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/parchment_deep">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/violet_chip" />
                </shape>
            </item>
            <item android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/violet_row" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
