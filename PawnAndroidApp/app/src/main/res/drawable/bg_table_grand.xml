<?xml version="1.0" encoding="utf-8"?>
<!-- The total pinned under a table: a gold rule above, then the gold wash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_rule" />
        </shape>
    </item>
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_wash" />
        </shape>
    </item>
</layer-list>
