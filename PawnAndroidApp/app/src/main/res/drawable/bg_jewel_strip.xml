<?xml version="1.0" encoding="utf-8"?>
<!-- What a bill holds, on its card in the Bills list (1.7): a quiet strip, so the jewels read as one thing. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/parchment_strip" />
    <stroke android:width="1dp" android:color="@color/parchment_line" />
    <corners android:radius="8dp" />
</shape>
