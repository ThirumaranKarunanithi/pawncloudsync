<?xml version="1.0" encoding="utf-8"?>
<!-- Back: the top screen falls away. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_cubic"
    android:zAdjustment="top">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="220" />
    <scale android:fromXScale="1" android:toXScale="0.94" android:fromYScale="1" android:toYScale="0.94"
        android:pivotX="50%" android:pivotY="42%" android:duration="220" />
</set>
