<?xml version="1.0" encoding="utf-8"?>
<!-- The next screen comes up from a little way back, as a dolly in. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:zAdjustment="top">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="240" />
    <scale android:fromXScale="0.93" android:toXScale="1" android:fromYScale="0.93" android:toYScale="1"
        android:pivotX="50%" android:pivotY="42%" android:duration="300" />
</set>
