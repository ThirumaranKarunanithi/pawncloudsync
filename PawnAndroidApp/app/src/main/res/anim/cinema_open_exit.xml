<?xml version="1.0" encoding="utf-8"?>
<!-- The screen being left passes the camera. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic">
    <alpha android:fromAlpha="1" android:toAlpha="0.25" android:duration="300" />
    <scale android:fromXScale="1" android:toXScale="1.05" android:fromYScale="1" android:toYScale="1.05"
        android:pivotX="50%" android:pivotY="42%" android:duration="300" />
</set>
