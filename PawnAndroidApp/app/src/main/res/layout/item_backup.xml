<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/page_pad"
    android:layout_marginEnd="@dimen/page_pad"
    android:layout_marginBottom="@dimen/sp_md"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_lg"
    android:paddingTop="@dimen/sp_md"
    android:paddingEnd="@dimen/sp_lg"
    android:paddingBottom="@dimen/sp_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cloud"
            android:tint="@color/gold_ink" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_md"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="@dimen/t_lead"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/ink_mute"
        android:textSize="@dimen/t_small" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="@dimen/t_small"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressItem"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_sm"
        android:indeterminate="true"
        android:indeterminateTint="@color/gold_rule"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDownload"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tap_min"
            android:text="Download"
            android:textColor="@color/wine_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnShare"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tap_min"
            android:layout_marginStart="4dp"
            android:text="Share"
            android:textColor="@color/gold_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
