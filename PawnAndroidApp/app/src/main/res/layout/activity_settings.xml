<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parchment"
    android:orientation="vertical">

    <include layout="@layout/view_band" />

    <TextView
        style="@style/SectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:text="APPEARANCE" />

    <LinearLayout
        android:id="@+id/rowTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_pad"
        android:layout_marginEnd="@dimen/page_pad"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/sp_lg"
        android:paddingTop="@dimen/sp_lg"
        android:paddingEnd="@dimen/sp_lg"
        android:paddingBottom="@dimen/sp_lg">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme"
                android:textColor="@color/ink"
                android:textSize="@dimen/t_lead"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvThemeDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/ink_mute"
                android:textSize="@dimen/t_small" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_seg_track"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/btnDark"
                style="@style/Royal.Button.Quiet"
                android:layout_width="78dp"
                android:layout_height="38dp"
                android:text="Dark"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLight"
                style="@style/Royal.Button.Quiet"
                android:layout_width="78dp"
                android:layout_height="38dp"
                android:layout_marginStart="3dp"
                android:text="Light"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
