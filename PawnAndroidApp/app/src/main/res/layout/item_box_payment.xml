<?xml version="1.0" encoding="utf-8"?>
<!-- One payment: amount and plan, its state, and when; a rejection shows its reason. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_table_row"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_lg"
    android:paddingTop="10dp"
    android:paddingEnd="@dimen/sp_lg"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWhat"
            style="@style/Royal.Value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/Royal.Pill.Closed" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMeta"
        style="@style/Royal.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvWhy"
        style="@style/Royal.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/ruby_ink"
        android:visibility="gone" />
</LinearLayout>
