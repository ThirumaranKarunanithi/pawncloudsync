<?xml version="1.0" encoding="utf-8"?>
<!--
  The bottom bar. Wine, bookending the band at the top, with the same
  gold rule between it and the page.

  Only the three top-level screens carry it — Home, Bills and Reports.
  Anything pushed on top of them (a bill, a drill-down) keeps the back
  arrow and no bar, which is how Android expects to be navigated.

  BottomNav.attach() tints the chosen tab and wires the rest.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/gold_rule" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/wine_deep"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/tap_min"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home"
                android:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Home"
                android:textColor="@color/nav_inactive"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/tap_min"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/navBillsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_bills"
                android:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/navBillsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Bills"
                android:textColor="@color/nav_inactive"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navReports"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/tap_min"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/navReportsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chart"
                android:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/navReportsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Reports"
                android:textColor="@color/nav_inactive"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/tap_min"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/navMoreIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_more"
                android:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/navMoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="More"
                android:textColor="@color/nav_inactive"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
