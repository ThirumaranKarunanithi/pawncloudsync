<?xml version="1.0" encoding="utf-8"?>
<!-- layoutContent stays a LinearLayout: the activity's field is typed
     to one, so the ScrollView goes AROUND it, never on it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parchment"
    android:orientation="vertical">

    <include layout="@layout/view_band" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/sp_md">

        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="@dimen/t_body"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnFrom"
                android:layout_width="0dp"
                android:layout_height="@dimen/tap_min"
                android:layout_weight="1"
                android:background="@drawable/bg_input_sunken"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/Royal.Cap.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FROM" />

                <TextView
                    android:id="@+id/tvFrom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/t_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:contentDescription="to"
                android:src="@drawable/ic_forward"
                android:tint="@color/gold_ink" />

            <LinearLayout
                android:id="@+id/btnTo"
                android:layout_width="0dp"
                android:layout_height="@dimen/tap_min"
                android:layout_weight="1"
                android:background="@drawable/bg_input_sunken"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/Royal.Cap.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TO" />

                <TextView
                    android:id="@+id/tvTo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/t_body"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:indeterminateTint="@color/wine"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingTop="@dimen/sp_lg"
            android:paddingEnd="@dimen/page_pad"
            android:paddingBottom="@dimen/sp_xl">

            <!-- Income -->
            <LinearLayout
                android:id="@+id/cardIncome"
                style="@style/Royal.Card"
                android:background="@drawable/bg_row_income">

                <LinearLayout style="@style/Royal.CardHead">
                    <TextView
                        style="@style/Royal.Cap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INCOME"
                        android:textColor="@color/emerald_ink" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llIncome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="4dp"
                    android:paddingEnd="@dimen/sp_lg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/sp_md"
                    android:background="@drawable/bg_result_good"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:text="TOTAL INCOME"
                        android:textColor="@color/emerald_ink"
                        android:textSize="@dimen/t_fine"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/emerald_ink"
                        android:textSize="@dimen/t_lead"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Expense -->
            <LinearLayout
                android:id="@+id/cardExpense"
                style="@style/Royal.Card"
                android:layout_marginTop="@dimen/sp_md"
                android:background="@drawable/bg_row_expense">

                <LinearLayout style="@style/Royal.CardHead">
                    <TextView
                        style="@style/Royal.Cap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EXPENSE"
                        android:textColor="@color/ruby_ink" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="4dp"
                    android:paddingEnd="@dimen/sp_lg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/sp_md"
                    android:background="@drawable/bg_result_bad"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:text="TOTAL EXPENSE"
                        android:textColor="@color/ruby_ink"
                        android:textSize="@dimen/t_fine"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/ruby_ink"
                        android:textSize="@dimen/t_lead"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Assets -->
            <LinearLayout
                android:id="@+id/cardAsset"
                style="@style/Royal.Card"
                android:layout_marginTop="@dimen/sp_md"
                android:background="@drawable/bg_row_silver">

                <LinearLayout style="@style/Royal.CardHead">
                    <TextView
                        style="@style/Royal.Cap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ASSETS"
                        android:textColor="@color/navy" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llAsset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="4dp"
                    android:paddingEnd="@dimen/sp_lg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/sp_md"
                    android:background="@drawable/bg_money_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:text="TOTAL ASSETS"
                        android:textColor="@color/wine"
                        android:textSize="@dimen/t_fine"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalAsset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wine"
                        android:textSize="@dimen/t_lead"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Liability / summary -->
            <LinearLayout
                android:id="@+id/cardLiability"
                style="@style/Royal.Card"
                android:layout_marginTop="@dimen/sp_md"
                android:background="@drawable/bg_row_repledge">

                <LinearLayout style="@style/Royal.CardHead">
                    <TextView
                        style="@style/Royal.Cap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIABILITY &amp; SUMMARY"
                        android:textColor="@color/violet" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llLiability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="4dp"
                    android:paddingEnd="@dimen/sp_lg"
                    android:paddingBottom="@dimen/sp_md" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
