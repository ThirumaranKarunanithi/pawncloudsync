<?xml version="1.0" encoding="utf-8"?>
<!--
  MIS Report.

  The summary used to show five figures out of sixteen columns: the
  repledge leg and the split between stock in the locker and stock at
  the lender were in the data and nowhere on screen. They are here now
  (total stock = locker + lender), with gross profit as interest earned
  less repledge interest spent, which is how the desktop reads it.

  The month table keeps its horizontal scroller: sixteen columns will
  never fit a phone, and the alternative is hiding the repledge and
  stock columns that make the report worth opening.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parchment"
    android:orientation="vertical">

    <include layout="@layout/view_band" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/sp_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCompanyName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRowCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sp_sm"
                android:textColor="@color/ink_mute"
                android:textSize="@dimen/t_small" />
        </LinearLayout>

        <!-- Table / Bar / Line / Pie. Buttons: the activity tints them. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_seg_track"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/btnViewTable"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_seg_active"
                android:stateListAnimator="@null"
                android:text="TABLE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnViewBar"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_seg_active"
                android:stateListAnimator="@null"
                android:text="BAR"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnViewLine"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_seg_active"
                android:stateListAnimator="@null"
                android:text="LINE"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnViewPie"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_seg_active"
                android:stateListAnimator="@null"
                android:text="PIE"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:indeterminateTint="@color/wine"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingTop="@dimen/sp_md"
            android:paddingEnd="@dimen/page_pad"
            android:paddingBottom="@dimen/sp_xl">

            <!-- ── Summary ───────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutSummary"
                style="@style/Royal.Card"
                android:visibility="gone">

                <LinearLayout style="@style/Royal.CardHead">

                    <TextView
                        style="@style/Royal.Cap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SUMMARY" />

                    <TextView
                        android:id="@+id/tvSummaryMonths"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink_mute"
                        android:textSize="@dimen/t_fine" />
                </LinearLayout>

                <!-- Company -->
                <TextView
                    style="@style/Royal.Cap.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="10dp"
                    android:text="COMPANY" />

                <LinearLayout style="@style/MisRow">
                    <TextView style="@style/MisRowLabel" android:text="Opened" />
                    <TextView android:id="@+id/tvSumPawnBills" style="@style/MisRowCount" />
                    <TextView android:id="@+id/tvSumPawnAmt"   style="@style/MisRowMoney" />
                </LinearLayout>

                <LinearLayout style="@style/MisRow">
                    <TextView style="@style/MisRowLabel" android:text="Closed" />
                    <TextView android:id="@+id/tvSumRedeemBills" style="@style/MisRowCount" />
                    <TextView android:id="@+id/tvSumRedeemAmt"   style="@style/MisRowMoney" />
                </LinearLayout>

                <LinearLayout style="@style/MisRow">
                    <TextView style="@style/MisRowLabel" android:text="Still out" />
                    <TextView android:id="@+id/tvSumEarnedBills" style="@style/MisRowCount" />
                    <TextView android:id="@+id/tvSumEarnedAmt"   style="@style/MisRowMoney" />
                </LinearLayout>

                <LinearLayout style="@style/MisRow">
                    <TextView style="@style/MisRowLabel" android:text="Interest earned" />
                    <TextView style="@style/MisRowCount" />
                    <TextView
                        android:id="@+id/tvSumProfit"
                        style="@style/MisRowMoney"
                        android:textColor="@color/emerald" />
                </LinearLayout>

                <!-- Repledge -->
                <TextView
                    style="@style/Royal.Cap.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="@dimen/sp_md"
                    android:text="REPLEDGE"
                    android:textColor="@color/violet" />

                <LinearLayout style="@style/MisRow">
                    <TextView style="@style/MisRowLabel" android:text="Opened" />
                    <TextView android:id="@+id/tvSumReplBills" style="@style/MisRowCount" />
                    <TextView android:id="@+id/tvSumReplAmt"   style="@style/MisRowMoney" />
                </LinearLayout>

                <LinearLayout style="@style/MisRow">
                    <TextView style="@style/MisRowLabel" android:text="Closed" />
                    <TextView android:id="@+id/tvSumReplRdmBills" style="@style/MisRowCount" />
                    <TextView android:id="@+id/tvSumReplRdmAmt"   style="@style/MisRowMoney" />
                </LinearLayout>

                <LinearLayout style="@style/MisRow">
                    <TextView style="@style/MisRowLabel" android:text="Interest spent" />
                    <TextView style="@style/MisRowCount" />
                    <TextView
                        android:id="@+id/tvSumReplIntr"
                        style="@style/MisRowMoney"
                        android:textColor="@color/ruby" />
                </LinearLayout>

                <!-- Stock -->
                <TextView
                    style="@style/Royal.Cap.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="@dimen/sp_md"
                    android:text="STOCK STILL OUT" />

                <LinearLayout style="@style/MisRow">
                    <TextView style="@style/MisRowLabel" android:text="In the locker" />
                    <TextView android:id="@+id/tvSumStockBills" style="@style/MisRowCount" />
                    <TextView android:id="@+id/tvSumStockAmt"   style="@style/MisRowMoney" />
                </LinearLayout>

                <LinearLayout style="@style/MisRow">
                    <TextView style="@style/MisRowLabel" android:text="At the lender" />
                    <TextView android:id="@+id/tvSumReplStockBills" style="@style/MisRowCount" />
                    <TextView
                        android:id="@+id/tvSumReplStockAmt"
                        style="@style/MisRowMoney"
                        android:textColor="@color/violet" />
                </LinearLayout>

                <LinearLayout style="@style/MisRow">
                    <TextView
                        style="@style/MisRowLabel"
                        android:text="Total stock"
                        android:textColor="@color/wine_ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSumTotalStockBills"
                        style="@style/MisRowCount"
                        android:textColor="@color/wine_ink"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSumTotalStockAmt"
                        style="@style/MisRowMoney"
                        android:textColor="@color/wine_ink" />
                </LinearLayout>

                <!-- Gross -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/sp_md"
                    android:background="@drawable/bg_result_good"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:text="GROSS PROFIT"
                        android:textColor="@color/emerald_ink"
                        android:textSize="@dimen/t_fine"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSumGross"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/emerald_ink"
                        android:textSize="@dimen/t_figure"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Which rows count ──────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutControls"
                style="@style/Royal.Card"
                android:layout_marginTop="@dimen/sp_md"
                android:padding="@dimen/sp_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSelectAll"
                        style="@style/Royal.Button.Quiet"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Select all"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnDeselectAll"
                        style="@style/Royal.Button.Quiet"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:text="Deselect all"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAll"
                        style="@style/Royal.Button.Quiet"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="All"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnSelected"
                        style="@style/Royal.Button.Quiet"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:text="Selected"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnDeselected"
                        style="@style/Royal.Button.Quiet"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:text="Deselected"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Chart ─────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutChart"
                style="@style/Royal.Card"
                android:layout_marginTop="@dimen/sp_md"
                android:padding="@dimen/sp_md"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvChartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/wine_ink"
                    android:textSize="@dimen/t_lead"
                    android:textStyle="bold"
                    style="@style/Royal.Font.Display" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/misBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="@dimen/sp_sm"
                    android:visibility="gone" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/misLineChart"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="@dimen/sp_sm"
                    android:visibility="gone" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/misPieChart"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="@dimen/sp_sm"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── The sixteen columns ───────────────────────────── -->
            <HorizontalScrollView
                android:id="@+id/layoutTableScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_md"
                android:background="@drawable/bg_card"
                android:scrollbars="horizontal">

                <TableLayout
                    android:id="@+id/tableMonthly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
