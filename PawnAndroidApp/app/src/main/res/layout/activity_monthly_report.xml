<?xml version="1.0" encoding="utf-8"?>
<!--
  MIS Report, with every option the desktop's has.

  ROWS: Split view / Totals only. SHOW: Stock Details / Profit / Assets &
  Liabilities. Select All, De Select All, Calculate Selected / De-Selected /
  All, Print. The total row sits pinned under the months, in the same columns.

  A phone has no double-click and no hover, so: the tick or the month ticks a
  row, a figure opens the list behind it, a long press shows its parts.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parchment"
    android:orientation="vertical">

    <include layout="@layout/view_band" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingTop="@dimen/sp_sm"
        android:paddingBottom="@dimen/sp_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_pad"
            android:paddingEnd="@dimen/page_pad">

            <TextView
                android:id="@+id/tvCompanyName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRowCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sp_sm"
                android:textColor="@color/ink_mute"
                android:textSize="@dimen/t_small" />

            <TextView
                android:id="@+id/btnOptions"
                style="@style/Royal.Chip"
                android:layout_marginStart="@dimen/sp_sm"
                android:layout_marginEnd="0dp"
                android:text="OPTIONS" />

            <TextView
                android:id="@+id/btnPrint"
                style="@style/Royal.Chip"
                android:layout_marginStart="@dimen/sp_sm"
                android:layout_marginEnd="0dp"
                android:text="PRINT" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_sm"
                android:clipToPadding="false"
                android:paddingStart="@dimen/page_pad"
                android:paddingEnd="@dimen/page_pad"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView style="@style/MisOptLabel" android:text="SHOW" />
                    <TextView android:id="@+id/chipStock" style="@style/Royal.Chip" android:text="Stock Details" />
                    <TextView android:id="@+id/chipProfit" style="@style/Royal.Chip" android:text="Profit" />
                    <TextView android:id="@+id/chipAL" style="@style/Royal.Chip" android:text="Assets &amp; Liabilities" />
                    <TextView style="@style/MisOptLabel" android:text="ROWS" />
                    <TextView android:id="@+id/chipSplit" style="@style/Royal.Chip" android:text="Split view" />
                    <TextView android:id="@+id/chipTotals" style="@style/Royal.Chip" android:text="Totals only" />
                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_sm"
                android:clipToPadding="false"
                android:paddingStart="@dimen/page_pad"
                android:paddingEnd="@dimen/page_pad"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/btnSelectAll" style="@style/Royal.Chip" android:text="Select All" />
                    <TextView android:id="@+id/btnDeselectAll" style="@style/Royal.Chip" android:text="De Select All" />
                    <TextView style="@style/MisOptLabel" android:text="CALCULATE" />
                    <TextView android:id="@+id/btnSelected" style="@style/Royal.Chip" android:text="Selected" />
                    <TextView android:id="@+id/btnDeselected" style="@style/Royal.Chip" android:text="De-Selected" />
                    <TextView android:id="@+id/btnAll" style="@style/Royal.Chip" android:text="All" />
                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_sm"
                android:clipToPadding="false"
                android:paddingStart="@dimen/page_pad"
                android:paddingEnd="@dimen/page_pad"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView style="@style/MisOptLabel" android:text="VIEW" />
                    <TextView android:id="@+id/btnViewTable" style="@style/Royal.Chip" android:text="Table" />
                    <TextView android:id="@+id/btnViewBar" style="@style/Royal.Chip" android:text="Bar" />
                    <TextView android:id="@+id/btnViewLine" style="@style/Royal.Chip" android:text="Line" />
                    <TextView android:id="@+id/btnViewPie" style="@style/Royal.Chip" android:text="Pie" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCloudNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gold_wash"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/sp_sm"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/sp_sm"
        android:textColor="@color/gold_ink"
        android:textSize="@dimen/t_fine"
        android:visibility="gone" />

    <!-- The totals for the months picked, big enough to read without scrolling across. -->
    <TextView
        android:id="@+id/tvTotalsOf"
        style="@style/Royal.Cap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/sp_sm"
        android:paddingEnd="@dimen/page_pad"
        android:text="TOTAL FOR ALL MONTHS"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/layoutTilesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/sp_xs"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/sp_sm"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutTiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:indeterminateTint="@color/gold_rule"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:id="@+id/layoutTableScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/tableHead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <ScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/tableMonthly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <LinearLayout
                    android:id="@+id/tableTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </HorizontalScrollView>

        <ScrollView
            android:id="@+id/layoutChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/page_pad"
            android:visibility="gone">

            <LinearLayout
                style="@style/Royal.Card"
                android:padding="@dimen/sp_md">

                <TextView
                    android:id="@+id/tvChartTitle"
                    style="@style/Royal.Font.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/wine_ink"
                    android:textSize="@dimen/t_lead"
                    android:textStyle="bold" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/misBarChart"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="@dimen/sp_sm"
                    android:visibility="gone" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/misLineChart"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="@dimen/sp_sm"
                    android:visibility="gone" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/misPieChart"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="@dimen/sp_sm"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
