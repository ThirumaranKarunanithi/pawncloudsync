<?xml version="1.0" encoding="utf-8"?>
<!--
  One metal on Home's Today's Rate board (1.7). The metal is the tile's left
  edge (bg_rate_gold / bg_rate_silver, set in HomeActivity), the rendered bars
  beside the name, the rate a gram large, the company rate under a rule.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_lg"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rateMetal"
                style="@style/Royal.Cap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/rateKind"
                style="@style/RoyalTileSub"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/rateIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="-4dp"
            android:layout_marginEnd="-2dp"
            android:contentDescription="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/rateFigure"
        style="@style/Royal.Figure"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="2dp"
        android:gravity="bottom|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        app:autoSizeMaxTextSize="26sp"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="7dp"
        android:background="@color/parchment_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rateCompanyLabel"
            style="@style/RoyalTileSub"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/rateCompany"
            style="@style/Royal.Num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
