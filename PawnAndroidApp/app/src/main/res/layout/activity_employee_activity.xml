<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parchment"
    android:orientation="vertical">

    <include layout="@layout/view_band" />

    <!-- Filter shelf -->
    <LinearLayout
        android:id="@+id/layoutFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/sp_md"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/sp_md">

        <LinearLayout
            style="@style/Royal.FieldBox"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_sunken">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                android:tint="@color/ink_mute" />

            <EditText
                android:id="@+id/etSearch"
                style="@style/Royal.Field"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:hint="A name, a bill number, anything typed"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textSize="@dimen/t_body" />
        </LinearLayout>

        <!-- Who / which screen / what -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spWho"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_sunken"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:popupBackground="@color/surface" />

            <Space
                android:layout_width="7dp"
                android:layout_height="1dp" />

            <Spinner
                android:id="@+id/spScreen"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_sunken"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:popupBackground="@color/surface" />

            <Space
                android:layout_width="7dp"
                android:layout_height="1dp" />

            <Spinner
                android:id="@+id/spAction"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.85"
                android:background="@drawable/bg_input_sunken"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:popupBackground="@color/surface" />
        </LinearLayout>

        <!-- From → To -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFrom"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_sunken"
                android:clickable="true"
                android:focusable="true"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:contentDescription="to"
                android:src="@drawable/ic_forward"
                android:tint="@color/gold_ink" />

            <TextView
                android:id="@+id/tvTo"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_sunken"
                android:clickable="true"
                android:focusable="true"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="@dimen/t_body"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/parchment_strip"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/sp_sm"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/sp_sm"
        android:textColor="@color/ink_body"
        android:textSize="@dimen/t_small" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:indeterminateTint="@color/wine"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="Nobody did anything that matches this"
        android:textColor="@color/ink_soft"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="@dimen/sp_md"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="@dimen/sp_md" />
</LinearLayout>
