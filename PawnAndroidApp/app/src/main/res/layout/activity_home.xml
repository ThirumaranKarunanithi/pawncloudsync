<?xml version="1.0" encoding="utf-8"?>
<!--
  Home. Band at the top, bar at the bottom, both wine; the shop's work
  on parchment between them.

  The five tiles are the five screens the owner opens by name. The bar's
  More sheet reaches the rest.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parchment"
    android:orientation="vertical">

    <include layout="@layout/view_band" />

    <ProgressBar
        android:id="@+id/progressCompany"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="32dp"
        android:indeterminateTint="@color/wine"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNoCompany"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="No companies found"
        android:textColor="@color/ink_soft"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingTop="@dimen/sp_lg"
            android:paddingEnd="@dimen/page_pad"
            android:paddingBottom="@dimen/sp_xl">

            <!-- ── Which company ─────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_wine"
                android:orientation="vertical"
                android:paddingStart="@dimen/sp_lg"
                android:paddingTop="9dp"
                android:paddingEnd="@dimen/sp_sm"
                android:paddingBottom="4dp">

                <TextView
                    style="@style/Royal.Cap.Quiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTIVE COMPANY" />

                <Spinner
                    android:id="@+id/spinnerCompany"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:popupBackground="@color/surface" />
            </LinearLayout>

            <!-- ── Operations ────────────────────────────────────── -->
            <LinearLayout style="@style/RoyalSectionRow">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="OPERATIONS"
                    android:textColor="@color/gold_ink"
                    android:textSize="@dimen/t_fine"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/parchment_line" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnBilling"
                    style="@style/RoyalTile">

                    <ImageView style="@style/RoyalTileIcon" android:src="@drawable/ic_search" />
                    <TextView style="@style/RoyalTileTitle" android:text="Search Bill" />
                    <TextView style="@style/RoyalTileSub" android:text="One bill, every figure" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/sp_md"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btnStockDetails"
                    style="@style/RoyalTile">

                    <ImageView style="@style/RoyalTileIcon" android:src="@drawable/ic_stock" />
                    <TextView style="@style/RoyalTileTitle" android:text="Stock Details" />
                    <TextView style="@style/RoyalTileSub" android:text="What is in the locker" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Accounts and reports ──────────────────────────── -->
            <LinearLayout style="@style/RoyalSectionRow">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="ACCOUNTS &amp; REPORTS"
                    android:textColor="@color/gold_ink"
                    android:textSize="@dimen/t_fine"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/parchment_line" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnTodaysAccount"
                    style="@style/RoyalTile"
                    android:background="@drawable/bg_row_income">

                    <ImageView
                        style="@style/RoyalTileIcon"
                        android:src="@drawable/ic_ledger"
                        android:tint="@color/emerald" />

                    <TextView style="@style/RoyalTileTitle" android:text="Today's Account" />
                    <TextView style="@style/RoyalTileSub" android:text="Debits, credits, deficit" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/sp_md"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/btnMonthlyReport"
                    style="@style/RoyalTile"
                    android:background="@drawable/bg_row_repledge">

                    <ImageView
                        style="@style/RoyalTileIcon"
                        android:src="@drawable/ic_chart"
                        android:tint="@color/violet" />

                    <TextView style="@style/RoyalTileTitle" android:text="MIS Report" />
                    <TextView style="@style/RoyalTileSub" android:text="Month by month" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnEmployeeActivity"
                style="@style/RoyalTile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_md"
                android:background="@drawable/bg_row_silver"
                android:gravity="center_vertical"
                android:minHeight="0dp"
                android:orientation="horizontal">

                <ImageView
                    style="@style/RoyalTileIcon"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/navy" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sp_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RoyalTileTitle"
                        android:layout_marginTop="0dp"
                        android:text="Who Did What" />

                    <TextView style="@style/RoyalTileSub" android:text="Every action, in order" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ink_mute" />
            </LinearLayout>

            <!-- ── Charts ────────────────────────────────────────── -->
            <LinearLayout style="@style/RoyalSectionRow">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="MONTH BY MONTH"
                    android:textColor="@color/gold_ink"
                    android:textSize="@dimen/t_fine"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@color/parchment_line" />
            </LinearLayout>

            <LinearLayout
                style="@style/Royal.Card"
                android:paddingStart="@dimen/sp_md"
                android:paddingTop="@dimen/sp_md"
                android:paddingEnd="@dimen/sp_md"
                android:paddingBottom="@dimen/sp_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Number of bills"
                    android:textColor="@color/wine"
                    android:textSize="@dimen/t_lead"
                    android:textStyle="bold"
                    style="@style/Royal.Font.Display" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartBillCount"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="@dimen/sp_sm" />
            </LinearLayout>

            <LinearLayout
                style="@style/Royal.Card"
                android:layout_marginTop="@dimen/sp_md"
                android:paddingStart="@dimen/sp_md"
                android:paddingTop="@dimen/sp_md"
                android:paddingEnd="@dimen/sp_md"
                android:paddingBottom="@dimen/sp_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total bill amount"
                    android:textColor="@color/wine"
                    android:textSize="@dimen/t_lead"
                    android:textStyle="bold"
                    style="@style/Royal.Font.Display" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartBillAmount"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="@dimen/sp_sm" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
