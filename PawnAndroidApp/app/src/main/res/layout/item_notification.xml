<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sp_md"
    android:background="@drawable/bg_row_gold"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_lg"
    android:paddingTop="@dimen/sp_md"
    android:paddingEnd="@dimen/sp_lg"
    android:paddingBottom="@dimen/sp_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/wine_ink"
            android:textSize="@dimen/t_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWhen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_sm"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ink_mute"
            android:textSize="@dimen/t_fine" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/ink_body"
        android:textSize="@dimen/t_body" />
</LinearLayout>
