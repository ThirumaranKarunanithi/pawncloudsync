<?xml version="1.0" encoding="utf-8"?>
<!--
  Today's Account.

  The operations table used to be five columns inside a
  HorizontalScrollView, the last of them a 220dp Combo, so Credits ran
  off the right edge of every phone. Combo is now a second line under
  the operation name (TodaysAccountActivity.buildOperationsTable), and
  the four columns that are left fit a 360dp screen with room to spare.

  The TOTAL strip sits OUTSIDE the TableLayout on purpose: the activity
  clears the table down to its header on every load, so a total row
  inside it would be thrown away.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/parchment"
    android:orientation="vertical">

    <include layout="@layout/view_band" />

    <!-- ── Which day, and is it open ─────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_pad"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_pad"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/tvCompanyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="@dimen/t_body"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnPickDate"
                android:layout_width="0dp"
                android:layout_height="@dimen/tap_min"
                android:layout_weight="1"
                android:background="@drawable/bg_input_gold"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/gold_ink" />

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/t_lead"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <!-- Parchment fill, because the activity sets this text to
                     amber (OPEN) or emerald itself. An amber pill would
                     have put amber on amber. -->
                <TextView
                    android:id="@+id/tvAccountStatus"
                    style="@style/Royal.Pill.Closed"
                    android:layout_width="wrap_content"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:indeterminateTint="@color/wine"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingTop="@dimen/sp_lg"
            android:paddingEnd="@dimen/page_pad"
            android:paddingBottom="@dimen/sp_xl">

            <!-- ── Carried forward ───────────────────────────────── -->
            <LinearLayout style="@style/Royal.Card">

                <LinearLayout style="@style/Royal.CardHead">

                    <TextView
                        style="@style/Royal.Cap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PREVIOUS DAY" />

                    <TextView
                        android:id="@+id/tvPreDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/ink_mute"
                        android:textSize="@dimen/t_fine" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/sp_lg"
                        android:paddingTop="11dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Royal.Cap.Quiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTUAL" />

                        <TextView
                            android:id="@+id/tvPreActual"
                            style="@style/Royal.Figure.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/parchment_strip" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Royal.Cap.Quiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVAILABLE" />

                        <TextView
                            android:id="@+id/tvPreAvailable"
                            style="@style/Royal.Figure.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/parchment_strip" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:orientation="vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="@dimen/sp_lg"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Royal.Cap.Quiet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEFICIT" />

                        <TextView
                            android:id="@+id/tvPreDeficit"
                            style="@style/Royal.Figure.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPreNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/parchment_strip"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="9dp"
                    android:paddingEnd="@dimen/sp_lg"
                    android:paddingBottom="9dp"
                    android:textColor="@color/ink_body"
                    android:textSize="@dimen/t_small"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ── Operations ────────────────────────────────────── -->
            <LinearLayout
                style="@style/Royal.Card"
                android:layout_marginTop="@dimen/sp_lg">

                <LinearLayout style="@style/Royal.TableHead">

                    <TextView
                        style="@style/Royal.TableHead.Cell"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="OPERATION" />

                    <TextView
                        style="@style/Royal.TableHead.Cell"
                        android:layout_width="30dp"
                        android:gravity="end"
                        android:text="NO." />

                    <TextView
                        style="@style/Royal.TableHead.Cell"
                        android:layout_width="70dp"
                        android:gravity="end"
                        android:text="DEBIT" />

                    <TextView
                        style="@style/Royal.TableHead.Cell"
                        android:layout_width="70dp"
                        android:gravity="end"
                        android:text="CREDIT" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/row_highlight"
                    android:paddingStart="@dimen/sp_md"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/sp_md"
                    android:paddingBottom="6dp"
                    android:text="Tap a row for the entries behind it."
                    android:textColor="@color/ink_mute"
                    android:textSize="@dimen/t_cap" />

                <!-- Rows are added by the activity. It clears everything
                     below child 0, so the header above must stay first
                     and nothing permanent may follow inside here. -->
                <TableLayout
                    android:id="@+id/tableOperations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0">

                    <TableRow android:layout_height="0dp" />
                </TableLayout>

                <!-- TOTAL — outside the table so the clear-down spares it -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_table_total"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/sp_md"
                    android:paddingTop="11dp"
                    android:paddingEnd="@dimen/sp_md"
                    android:paddingBottom="11dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:text="TOTAL"
                        android:textColor="@color/wine_ink"
                        android:textSize="@dimen/t_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalDebit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:textColor="@color/ruby"
                        android:textSize="@dimen/t_small"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTotalCredit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sp_md"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:textColor="@color/emerald"
                        android:textSize="@dimen/t_small"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Profit ────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Royal.Cap.Quiet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GOLD PF" />

                    <TextView
                        android:id="@+id/tvGoldPf"
                        style="@style/Royal.Figure.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="9dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Royal.Cap.Quiet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SILVER PF" />

                    <TextView
                        android:id="@+id/tvSilverPf"
                        style="@style/Royal.Figure.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="9dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_row_income"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="10dp">

                    <TextView
                        style="@style/Royal.Cap.Quiet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL PF" />

                    <TextView
                        android:id="@+id/tvTotalPf"
                        style="@style/Royal.Figure.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/emerald" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Today's balance ───────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_lg"
                android:background="@drawable/bg_crest"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="13dp"
                    android:paddingEnd="@dimen/sp_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's balance"
                        android:textColor="@color/on_wine_title"
                        android:textSize="@dimen/t_title"
                        android:textStyle="bold"
                        style="@style/Royal.Font.Display" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@color/on_wine_rule" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="10dp"
                    android:paddingEnd="@dimen/sp_lg"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Royal.Cap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTUAL"
                            android:textColor="@color/on_wine_dim" />

                        <TextView
                            android:id="@+id/tvActualBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/on_wine"
                            android:textSize="@dimen/t_figure"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="34dp"
                        android:layout_gravity="bottom"
                        android:background="@color/on_wine_rule" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Royal.Cap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AVAILABLE"
                            android:textColor="@color/on_wine_dim" />

                        <TextView
                            android:id="@+id/tvAvailableBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/on_wine_good"
                            android:textSize="@dimen/t_figure"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="34dp"
                        android:layout_gravity="bottom"
                        android:background="@color/on_wine_rule" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="0.8"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Royal.Cap"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DEFICIT"
                            android:textColor="@color/on_wine_dim" />

                        <TextView
                            android:id="@+id/tvDeficit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/on_wine_good"
                            android:textSize="@dimen/t_figure"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTodaysNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_crest_foot"
                    android:paddingStart="@dimen/sp_lg"
                    android:paddingTop="9dp"
                    android:paddingEnd="@dimen/sp_lg"
                    android:paddingBottom="9dp"
                    android:textColor="@color/on_wine_title"
                    android:textSize="@dimen/t_small"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
