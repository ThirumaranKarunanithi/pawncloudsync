<?xml version="1.0" encoding="utf-8"?>
<!-- After paying: where the money goes (for paying by hand) and the UTR box. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_xl"
    android:paddingTop="@dimen/sp_md"
    android:paddingEnd="@dimen/sp_xl">

    <TextView
        android:id="@+id/tvPayTo"
        style="@style/Royal.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_result_warn"
        android:padding="10dp"
        android:textIsSelectable="true" />

    <TextView
        style="@style/Royal.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sp_md"
        android:text="Once it is paid, type the 12-digit UTR. Your payment app shows it on the payment as UTR, UPI reference or UPI transaction ID." />

    <LinearLayout
        style="@style/Royal.FieldBox"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/sp_sm"
        android:background="@drawable/bg_input_sunken">

        <EditText
            android:id="@+id/etUtr"
            style="@style/Royal.Field"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:digits="0123456789"
            android:hint="12-digit UTR"
            android:importantForAutofill="no"
            android:inputType="number"
            android:letterSpacing="0.12"
            android:maxLength="12"
            android:textSize="@dimen/t_lead" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvUtrCount"
        style="@style/Royal.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:text="0 of 12" />
</LinearLayout>
