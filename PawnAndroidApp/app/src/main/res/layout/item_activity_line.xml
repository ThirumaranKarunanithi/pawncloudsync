<?xml version="1.0" encoding="utf-8"?>
<!-- One thing somebody did. The action is a pill, coloured by what kind
     of thing it was; StatusPill.paintAction does that at bind time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sp_md"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_lg"
    android:paddingTop="@dimen/sp_md"
    android:paddingEnd="@dimen/sp_lg"
    android:paddingBottom="@dimen/sp_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAction"
            style="@style/Royal.Pill.Closed"
            android:layout_width="wrap_content" />

        <TextView
            android:id="@+id/tvScreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_sm"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textSize="@dimen/t_small"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWhen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_sm"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ink_mute"
            android:textSize="@dimen/t_fine" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ink_body"
        android:textSize="@dimen/t_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold_ink"
            android:textSize="@dimen/t_small"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBill"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_sm"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/wine"
            android:textSize="@dimen/t_small"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ink_mute"
            android:textSize="@dimen/t_fine" />
    </LinearLayout>
</LinearLayout>
