<?xml version="1.0" encoding="utf-8"?>
<!--
  A bill row. The metal reads off the left edge, so the eye can sort
  gold from silver down a long list without reading a word.

  BillAdapter sets the edge drawable per row; bg_row_gold here is only
  what the preview shows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sp_md"
    android:background="@drawable/bg_row_gold"
    android:orientation="vertical"
    android:paddingStart="@dimen/sp_lg"
    android:paddingTop="@dimen/sp_md"
    android:paddingEnd="@dimen/sp_lg"
    android:paddingBottom="@dimen/sp_md">

    <!-- Bill number · metal · status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvBillNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMaterial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_sm"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:textSize="@dimen/t_cap"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/Royal.Pill.Closed"
            android:layout_width="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCustomer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/ink"
        android:textSize="@dimen/t_body" />

    <TextView
        android:id="@+id/tvMobile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/ink_mute"
        android:textSize="@dimen/t_small" />

    <!-- Money · date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAmount"
            style="@style/Royal.MoneyChip" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sp_sm"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ink_mute"
            android:textSize="@dimen/t_small" />
    </LinearLayout>
</LinearLayout>
