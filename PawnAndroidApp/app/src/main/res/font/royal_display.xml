<?xml version="1.0" encoding="utf-8"?>
<!--
  Playfair Display. The shop's name, screen titles, and the figure that
  answers the question. Nothing else.

  Static instances, not the variable font: minSdk is 21 and variable
  axes only work from 26, so a variable file would render Regular and
  let Android fake the bold.

  Both namespaces are declared on every entry — app: is what AppCompat
  reads below API 26, android: is what the platform reads above it.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/playfair_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/playfair_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        android:font="@font/playfair_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/playfair_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

</font-family>
