# Copy to %PROGRAMDATA%\PawnBroking\sync.properties on each shop machine.
# Different shop_id per machine: alwarpuram, annanagar, etc.

db.url=jdbc:postgresql://localhost:5432/pawnbroking
db.user=postgres
db.password=CHANGE_ME

cloud.url=https://devpawn.magizhchi.academy
cloud.api_key=PUT_THE_PER_SHOP_API_KEY_HERE
shop.id=alwarpuram

batch.size=200
poll.interval.ms=5000
health.port=17654

# How often SchemaGuard checks/repairs the local DB schema (sync_outbox
# table + triggers). After a DB restore wipes these, the agent will
# re-install them within this interval — no manual psql work needed.
schema.guard.interval.ms=30000

# How often ImageWatcher scans the bill-image directories on disk and
# uploads new files to the cloud. Defaults to 60s.
image.scan.interval.ms=60000
# Optional override for the image root path. If blank (the default) the
# watcher reads company_other_settings.camera_temp_file_name for each
# company so multiple shops with different paths just work.
#image.root=D:\\Pawnbroking\\pawnbrokingImages\\Test
